  publisher = {AAAI press},
  number = {1},
  pages = {500--508},
  editor = {Sven Koenig and Roni Stern and Mauro Vallati},
  booktitle = {Proceedings of the Thirty-third International Conference on Automated Planning and Scheduling},
  address = {United States},
