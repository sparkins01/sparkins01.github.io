  publisher = {SciTePress},
  pages = {292--299},
  editor = {{Di Pietro}, {Roberto } and Karen Renaud and Paolo Mori},
  booktitle = {Proceedings of the 12th International Conference on Information Systems Security and Privacy - (Volume 1)},
  address = {Portugal},
  url = {https://icissp.scitevents.org/}
